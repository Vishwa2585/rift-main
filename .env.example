# ==============================================================================
# RIFT & RIFT BANK CONFIGURATION SPECIFICATION
# Project: RIFT (Real-Time Interchain Fraud Tracking) | CSB-01
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RIFT Core Backend Service (Authoritative Fraud Detection Engine)
# ------------------------------------------------------------------------------
# Base URL for RIFT Core REST API.
# When RIFT Core is hosted as an independent microservice, set this to the deployed service URL.
RIFT_CORE_URL=http://localhost:3000/api/v1
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Server-to-Server Authentication Credentials (KEEP SECRET - SERVER-SIDE ONLY)
# Never expose these keys to browser frontends, public repos, or client bundles.
# ------------------------------------------------------------------------------
# Server-to-server API key passed via HTTP header: 'x-rift-api-key' or 'X-RIFT-API-Key'
# Used by the Bank Server-Side API Adapter to authenticate requests to RIFT Core.
RIFT_API_KEY=rift_sec_rot_8d31b947c61e4a29a05fb82301c4e7da

# HMAC-SHA256 signing secret passed via HTTP header: 'x-rift-signature'
# Used to sign cross-chain bridge and settlement reconciliation webhooks.
RIFT_WEBHOOK_SECRET=rift_whsec_rot_1f94c730e8a2b56d819c43e02f5a8b71

# ------------------------------------------------------------------------------
# 3. Persistent Supabase Storage Configuration (rift_ Prefixed Tables)
# ------------------------------------------------------------------------------
# Supabase project URL and service-role / anon keys for cross-instance persistence.
# Tables used: rift_transactions, rift_incidents, rift_nonces, rift_idempotency
# If omitted, system seamlessly falls back to in-memory store for local testing.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role secret (SERVER-ONLY — grants administrative database access, NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. Separate RIFT Bank Service Configuration (Supabase Core Banking Ledger)
# ------------------------------------------------------------------------------
# Deployed service URL for the external RIFT Bank application.
# If RIFT Bank is deployed separately from RIFT Core, specify its authoritative URL here.
RIFT_BANK_SERVICE_URL=
